# ==============================================================================
# THE MARGINS — SUPABASE & OAUTH CONFIGURATION
# ==============================================================================
# Copy this file to .env or .env.local and populate the values below.
# These variables are required for real Google and GitHub OAuth authentication,
# persistent database storage with Row-Level Security (RLS), and live guestbook notes.
#
# If left empty or unset, the application gracefully operates in Developer Preview mode
# with local guestbook storage and preview sessions so that your portfolio never crashes.
# ==============================================================================

# 1. Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Public API Key (Found in Project Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ==============================================================================
# OAUTH REDIRECT URLS TO CONFIGURE IN SUPABASE DASHBOARD:
# (Authentication -> URL Configuration -> Redirect URLs)
#
# Local development:
# http://localhost:5173/auth/callback
# http://localhost:5174/auth/callback
#
# Production (replace with your custom domain or Vercel URL):
# https://your-portfolio-domain.com/auth/callback
# ==============================================================================
